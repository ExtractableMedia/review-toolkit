{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(claude plugin validate:*)",
      "Bash(markdownlint:*)",
      "Bash(npx markdownlint-cli:*)",
      "Bash(shellcheck:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-markdown.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
