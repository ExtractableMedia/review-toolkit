{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Add this hook entry to .claude/settings.json to audit triage decisions. Point the command at your copy of log-triage-decisions.sh.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-triage-decisions.sh"
          }
        ]
      }
    ]
  }
}
