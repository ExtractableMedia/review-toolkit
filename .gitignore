# See https://help.github.com/articles/ignoring-files for more about ignoring files

# Ignore Claude Code's local state. This repository is public and agent memory holds working context
/.claude/agent-memory/
/.claude/settings.local.json
/.claude/worktrees/
/.claude/*.lock

# Ignore the cache a language server or coding assistant writes into the project
/.serena/

# Ignore the Node modules a local run of the workflow's CLI install leaves behind
/node_modules/
